{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.devjoaocastro/vulk-mcp-server",
  "title": "VULK",
  "description": "Generate, edit, and deploy immersive 3D/WebGL web projects from any MCP assistant.",
  "repository": {
    "url": "https://github.com/VULK-dev/vulk-mcp-server",
    "source": "github"
  },
  "version": "1.1.1",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.vulk.dev/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "vulk-mcp-server",
      "version": "1.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your VULK API key (get at vulk.dev/settings/api-keys)",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "VULK_API_KEY"
        }
      ]
    }
  ]
}
